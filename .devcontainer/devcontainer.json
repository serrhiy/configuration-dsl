{
    "name": "configuration-dsl",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/configuration-dsl,type=bind",
    "workspaceFolder": "/configuration-dsl",
    "runArgs": [
        "--hostname=debian"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}